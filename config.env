# [Google Control Hub] 환경 설정 파일 (config.env)
# Google AI Studio (https://aistudio.google.com/)에서 발급받은 키를 아래에 입력하십시오.

GEMINI_API_KEY=

# Google AI 모델 기본값 설정
GEMINI_MODEL=gemini-2.5-flash
IMAGEN_MODEL=imagen-3.0-generate-002
VEO_MODEL=veo-2.0-generate-001

# Google Drive 및 로컬 백업 경로
GOOGLE_DRIVE_BACKUP_PATH=G:/내 드라이브/AntiGravity_Backups
LOCAL_BACKUP_PATH=D:/UserFiles/Desktop/AntiGravity_Backups
OUTPUTS_DIR=outputs
